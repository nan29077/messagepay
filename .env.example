# ---------------------------------------------------------------------------
# TORNADO 환경변수 예시. 실제 값은 .env 또는 AWS Secrets Manager 로 주입한다.
# 어떤 키도 소스코드/로그/프론트엔드에 하드코딩하지 않는다.
# ---------------------------------------------------------------------------

# --- 기본 ---
PORT="3025"
APP_ENV="local"                       # local | staging | prod (미설정·오타는 안전하게 prod 로 간주)
APP_BASE_URL="http://localhost:3025"
APP_TIMEZONE="Asia/Seoul"

# --- 데이터베이스 (AWS RDS / Aurora PostgreSQL) ---
# 운영: postgresql://user:pass@tornado.cluster-xxxx.ap-northeast-2.rds.amazonaws.com:5432/tornado?schema=public&sslmode=require&connection_limit=10
DATABASE_URL="postgresql://tornado:tornado@127.0.0.1:5432/tornado?schema=public"
# RDS Proxy / PgBouncer 경유 시 사용 (마이그레이션은 DIRECT_DATABASE_URL 사용)
DIRECT_DATABASE_URL=""

# --- 이미지 저장소 ---
# local = 서버 로컬 디스크(var/uploads). 단일 서버 전용.
# s3    = Amazon S3. 다중 인스턴스/재배포에도 이미지가 유지된다. **운영 필수**
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_PREFIX="uploads"
# CloudFront 등 공개 배포 도메인. 비우면 /api/media 라우트를 경유해 서빙한다.
S3_PUBLIC_BASE=""

# --- 드리프트 탐지용 섀도 DB (CI 에서만 사용) ---
# prisma migrate diff --from-migrations 로 스키마-마이그레이션 불일치를 검사할 때 필요하다.
SHADOW_DATABASE_URL=""

# --- Redis (ElastiCache) ---
REDIS_URL="redis://127.0.0.1:6379"
# Redis 미설치 환경에서 인메모리 폴백 허용 (운영에서는 false)
ALLOW_INMEMORY_FALLBACK="true"

# --- 암호화 (로컬 전용. 운영은 AWS KMS 사용) ---
CRYPTO_PROVIDER="local"               # local | aws-kms
# 32바이트 base64. openssl rand -base64 32
CRYPTO_MASTER_KEY="ZGV2LW9ubHktbWFzdGVyLWtleS0zMi1ieXRlcy0hIQ=="
PHONE_HASH_SECRET="dev-only-phone-hmac-secret-change-me"
SESSION_SECRET="dev-only-session-secret-change-me-please"
AWS_REGION="ap-northeast-2"
AWS_KMS_KEY_ID=""

# --- 결제: 헥토파이낸셜 내통장결제(EzAuth) ---
PAYMENT_PROVIDER="mock"               # mock | hecto
HECTO_MID=""
HECTO_LICENSE_KEY=""
HECTO_AES_KEY=""
HECTO_HASH_KEY=""
# 내통장결제(EzAuth)는 결제창 호스트와 서버 API 호스트가 다르다. 절대 합치지 말 것.
HECTO_AUTH_UI_BASE="https://ezauth.settlebank.co.kr"          # 결제창 + SettlePay.js
HECTO_AUTH_API_BASE="https://ezauthapi.settlebank.co.kr:8081" # 승인/빌키 API
HECTO_CALLBACK_URL="${APP_BASE_URL}/api/payments/hecto/return"
HECTO_RETURN_URL="${APP_BASE_URL}/api/payments/hecto/return"
HECTO_NOTI_URL="${APP_BASE_URL}/api/payments/hecto/notify"
# 결제인증 후 승인 API 호출 제한(공식 10분)보다 짧게 설정
PAYMENT_CONFIRM_TTL_SEC="300"
# PIN 입력 링크 유효시간 (초). 결제사 인증창 유효시간(10분)을 넘기지 않는다.
PAYMENT_PIN_TTL_SEC="300"
# PIN 완료 콜백(X-Pin-Secret) 검증용 공유 비밀. 운영에서는 필수이며 비어 있으면 기동이 중단된다.
# (로컬에서만 비워 둘 수 있다. 실연동 시 결제사 서명 검증으로 교체한다)
PAYMENT_PIN_CALLBACK_SECRET=""
# PIN 완료 콜백에서 "인증 성공"으로 인정할 결과코드 (콤마 구분, 대소문자 무관).
# 이 목록에 없는 코드는 인증 실패로 처리되며 승인(출금)을 실행하지 않는다.
PAYMENT_PIN_SUCCESS_CODES="0000,OK,SUCCESS,MOCK"

# --- MO 문자 수신 ---
MO_PROVIDER="mock"                    # mock | mtonet
MO_WEBHOOK_SECRET="dev-only-mo-webhook-secret"
MO_ALLOWED_IPS=""                     # 콤마 구분. APP_ENV=local 에서만 비워둘 수 있다(운영은 fail-closed)
# --- MTONET 050 / MO ---
MTONET_USER_ID=""
MTONET_API_KEY=""

# --- MT 문자 발송 ---
MT_PROVIDER="mock"                    # mock | <사업자코드>
MT_API_KEY=""
MT_API_SECRET=""
MT_FROM_NUMBER="15881234"             # 발신번호 사전등록 완료 번호

# --- 유튜브 ---
YOUTUBE_PROVIDER="mock"               # mock | google
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="${APP_BASE_URL}/api/youtube/oauth/callback"
YOUTUBE_API_KEY=""
# 일일 할당량 가드 (실측 후 조정)
YOUTUBE_DAILY_QUOTA="10000"
YOUTUBE_INSERT_QUOTA_COST="50"

# --- 소셜 간편 로그인 (카카오 / 네이버) ---
# 키가 비어 있으면 화면에 "연동 준비 중"으로 표시되고 로그인은 진행되지 않는다.
# 카카오: 카카오 디벨로퍼스 > 앱 > REST API 키, 카카오 로그인 Redirect URI 등록
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_REDIRECT_URI="${APP_BASE_URL}/api/auth/social/kakao/callback"
# 네이버: 네이버 개발자센터 > 애플리케이션 등록 > Client ID/Secret, Callback URL 등록
NAVER_CLIENT_ID=""
NAVER_CLIENT_SECRET=""
NAVER_REDIRECT_URI="${APP_BASE_URL}/api/auth/social/naver/callback"

# --- TTS ---
TTS_PROVIDER="mock"                   # mock | browser | google | azure
TTS_API_KEY=""

# --- 객체 저장소 ---
S3_BUCKET=""
S3_PUBLIC_BASE=""

# --- 정리 배치 스케줄러 ---
# AWS EventBridge Scheduler 등 외부 크론이 1분 간격으로 호출한다.
#   GET ${APP_BASE_URL}/api/cron/cleanup   Authorization: Bearer ${CRON_SECRET}
# 만료된 PIN 인증/확인 링크 자동 취소와 만료 멱등키 삭제를 수행한다.
# 비어 두면 로컬(APP_ENV=local)에서만 호출이 허용되고 그 외 환경에서는 전건 401 로 거절된다.
CRON_SECRET=""

# --- 운영 안전장치 ---
# DIRECT_TRIGGER 모드는 금융사 서면승인 등록 전에는 절대 활성화하지 않는다
ALLOW_DIRECT_TRIGGER="false"
# 실제 결제/실제 MT 발송 차단 스위치 (승인 전 true 유지)
SAFE_MODE="true"
