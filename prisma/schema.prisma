  @@index([scope, active])
  @@map("donation_limit_policy")
}

/// 기간별 후원 집계 (Redis 캐시의 영속 원본)
model DonationCounter {
  id         String   @id
  donorId    String   @map("donor_id")
  /// 전체 합계 행은 'ALL' 센티널 사용.
  /// (PostgreSQL 은 NULL 을 서로 다른 값으로 취급하므로 UNIQUE 제약이 무력화된다)
  creatorId  String   @default("ALL") @map("creator_id")
  periodType String   @map("period_type")
  periodKey  String   @map("period_key")
  count      Int      @default(0)
  amount     BigInt   @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([donorId, creatorId, periodType, periodKey])
  @@index([periodKey])
  @@map("donation_counter")
}

